<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron с hardened runtime не запустится без этих двух. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Микрофон и распознавание речи для голосового ввода. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.speech-recognition</key>
    <true/>

    <!-- Нужно, чтобы открывать окно Terminal.app через Apple Events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Пользователь сам выбирает папку проекта, и в ней работает Claude Code. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- bridge.js и stt-helper запускаются как отдельные процессы. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
